# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored and never committed.

# --- RPC endpoints ---
# Required for fork tests (contracts matching *Fork* or *Polygon*) and for deploys.
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
BASE_RPC_URL=
# Optional: used by Sepolia-fork test setups and by scripts broadcasting to Sepolia.
SEPOLIA_RPC_URL=

# --- Deployer identity (EOA scripts) ---
# The pool scripts and the legacy council/adaptor scripts broadcast from an EOA and resolve
# their signer from env in a consistent order:
#   1. ETH_FROM        -- hardware wallet / keystore flow
#   2. PRIVATE_KEY     -- raw key, fallback for headless deploys
#   3. (CreateCouncilNftsAndStreams only) falls back to an on-chain MEXC
#      address that reliably holds enough TEL for the stream deposits.
ETH_FROM=
PRIVATE_KEY=

# --- Safe deployment identity (safe-utils scripts) ---
# The TELx registry/subscriber deploy runs through safe-utils rather than an EOA: it proposes a
# MultiSend batch to the Safe Transaction Service and signs with a hardware wallet.
# Requires FOUNDRY_PROFILE=deploy and --ffi.
#
# The Safe that owns the deployment (also the CREATE3 salt guard, so changing it changes every
# predicted address).
DEPLOYER_SAFE_ADDRESS=
# EOA submitting the Safe transaction. For a multi-sig flow use the indexed form instead.
SIGNER_ADDRESS=
# SIGNER_ADDRESS_0=
# SIGNER_ADDRESS_1=
# BIP-44 derivation path override, e.g. m/44'/60'/0'/0/0
# DERIVATION_PATH=
# Hardware wallet type: "ledger" (default) or "trezor"
# HARDWARE_WALLET=
# Queue behind Safe transactions that are proposed but not yet executed.
# SAFE_NONCE_OFFSET=
# Restrict a multi-chain deploy script to a single chain by name (ethereum | polygon | base).
# CHAIN=

# --- Contract verification ---
# Etherscan V2 serves every supported chain from one key.
ETHERSCAN_API_KEY=

# --- Chain infrastructure addresses ---
# Defaults live in `script/shared/EthereumAddresses.sol`, `PolygonAddresses.sol` and
# `BaseAddresses.sol`. Scripts read each via `vm.envOr(KEY, library_default)`, so the vars below
# only need setting to OVERRIDE a library default (e.g., a testnet fork or staging environment).
# For mainnet deployments, leave them unset and the library defaults apply.
#
# Available override keys (all optional), per chain prefix ETHEREUM_ / POLYGON_ / BASE_:
#   <CHAIN>_POOL_MANAGER, <CHAIN>_POSITION_MANAGER, <CHAIN>_UNIVERSAL_ROUTER, <CHAIN>_STATE_VIEW,
#   <CHAIN>_TEL_TOKEN, <CHAIN>_EUSD_TOKEN, <CHAIN>_EMXN_TOKEN, <CHAIN>_WETH_TOKEN,
#   <CHAIN>_USDC_TOKEN, <CHAIN>_SUPPORT_SAFE, <CHAIN>_GOVERNANCE_SAFE.

# --- Test-only overrides ---
# Pin a different fork height for the deploy-script fork tests.
# FORK_BLOCK_NUMBER=
